FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-recommendation.txt ./
RUN pip install --no-cache-dir -r requirements-recommendation.txt

COPY recsys_loom recsys_loom
COPY services services

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app \
    && chown -R app:app /app

USER app
EXPOSE 8000
CMD ["uvicorn", "services.recommendation.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
