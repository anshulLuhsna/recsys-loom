# Backend
RECSYS_HOST=0.0.0.0
RECSYS_PORT=8000
API_DOMAIN=api.example.com
ALLOWED_ORIGINS=https://your-project.vercel.app
CATALOG_PATH=/app/articles.csv
RECOMMENDATION_SERVICE_URL=http://recommendation-api:8000
RECOMMENDATION_TIMEOUT_SECONDS=0.35
LOG_LEVEL=INFO

# Deployment values are written by CI using immutable image digests.
# RECOMMENDATION_IMAGE=000000000000.dkr.ecr.ap-south-1.amazonaws.com/recsys-recommendation@sha256:...
# SEARCH_IMAGE=000000000000.dkr.ecr.ap-south-1.amazonaws.com/recsys-search@sha256:...
# RECOMMENDATION_IMAGE_DIGEST=sha256:...
# SEARCH_IMAGE_DIGEST=sha256:...
# RELEASE_DIR=/opt/recsys-loom/releases/current
# IMAGES_DIR=/opt/recsys-loom/images
# LOG_DIR=/var/log/recsys-loom
RECOMMENDATION_MEMORY_LIMIT=768m
RECOMMENDATION_CPU_LIMIT=0.75
SEARCH_MEMORY_LIMIT=2g
SEARCH_CPU_LIMIT=1.5

# MiniLM is off because it did not improve the BM25-favoring synthetic
# token-overlap benchmark; real semantic-search value remains inconclusive.
SEARCH_SEMANTIC=0
SEARCH_WARM_ON_READINESS=1

# Requires artifacts from scripts/encode_visual_search_images.py.
SEARCH_VISUAL=0

# Optional GenRec-inspired catalog-grounded search. Disabled unless explicitly
# enabled with an OpenAI-compatible API key. GROQ_API_KEY is also accepted.
SEARCH_LLM=0
SEARCH_LLM_BASE_URL=https://api.groq.com/openai/v1
# SEARCH_LLM_API_KEY=
# GROQ_API_KEY=
SEARCH_LLM_MODEL=llama-3.3-70b-versatile
SEARCH_LLM_TIMEOUT_SECONDS=4
SEARCH_LLM_RERANK_LIMIT=30
SEARCH_LLM_MAX_CALLS_PER_MINUTE=30

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
