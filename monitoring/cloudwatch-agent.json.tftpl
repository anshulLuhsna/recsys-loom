{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_active",
          "cpu_usage_iowait",
          "cpu_usage_system",
          "cpu_usage_user"
        ],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "disk": {
        "measurement": [
          "used_percent",
          "inodes_free",
          "inodes_used"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/",
          "/mnt/lab-faults"
        ],
        "drop_device": true,
        "dimensions": [
          [
            "fstype",
            "path"
          ]
        ]
      },
      "mem": {
        "measurement": [
          "mem_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": 60
      },
      "processes": {
        "measurement": [
          "total",
          "running",
          "blocked",
          "zombies"
        ],
        "metrics_collection_interval": 60
      }
    },
    "force_flush_interval": 60
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/recsys-loom/logs/application.log",
            "log_group_name": "${application_log_group_name}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/recsys-loom/caddy/access.log",
            "log_group_name": "${application_log_group_name}",
            "log_stream_name": "{instance_id}-caddy",
            "timezone": "UTC"
          },
          {
            "file_path": "/opt/recsys-loom/logs/deploy.log",
            "log_group_name": "${deployment_log_group_name}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/lib/docker/containers/*/*.log",
            "log_group_name": "${docker_log_group_name}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          },
          {
            "file_path": "/opt/recsys-loom/logs/docker-events.log",
            "log_group_name": "${docker_log_group_name}",
            "log_stream_name": "{instance_id}-events",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "${system_log_group_name}",
            "log_stream_name": "{instance_id}",
            "timezone": "UTC"
          }
        ]
      }
    },
    "force_flush_interval": 15
  }
}
