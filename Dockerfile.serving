FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/var/cache/huggingface

WORKDIR /app
COPY requirements-serving.txt requirements-recommendation.txt requirements-search.txt ./
RUN pip install --no-cache-dir -r requirements-serving.txt

COPY recsys_loom recsys_loom
COPY services services

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir -p /var/cache/huggingface \
    && chown -R app:app /app /var/cache/huggingface

USER app
EXPOSE 8000
CMD ["uvicorn", "services.recommender.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
