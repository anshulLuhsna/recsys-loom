{$API_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
			roll_keep_for 168h
		}
		format json
	}

	handle /images/* {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy api:8000
	}
}
